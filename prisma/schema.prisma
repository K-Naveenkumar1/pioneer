generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id         String    @id @default(uuid())
  firstname  String
  lastname   String
  clerkId    String    @unique
  image      String?
  stripeId   String
  group      Group[]
  membership Members[]
  posts      Post[]
  likes      Like[]
  comments   Comment[]
  message    Message[]
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  price     Int?
  active    Boolean  @default(false)
  groupId   String
  Group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Group {
  id              String         @id @default(uuid())
  name            String         @unique
  category        String
  thumbnail       String?
  description     String?
  gallery         String?
  JsonDescription String?
  htmlDescription String?
  icon            String?
  privacy         GROUP_PRIVACY  @default(PRIVATE)
  active          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  userId          String
  domain          String?
  member          Members[]
  channel         Channel[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses         Course[]
  affiliate       Affiliate?
  subscription    Subscription[]
}

model Members {
  id        String   @id @default(uuid())
  userId    String?
  groupId   String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  Group     Group?   @relation(fields: [groupId], references: [id])

  @@index([userId, groupId])
}

model Post {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  title       String?
  JsonContent String?
  htmlContent String?
  content     String
  authorId    String
  channelId   String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  comments    Comment[]
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  content   String
  postId    String
  userId    String
  replied   Boolean?  @default(false)
  commentId String?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply     Comment[] @relation("CommentToComment")
  Comment   Comment?  @relation("CommentToComment", fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  icon      String
  createdAt DateTime @default(now())
  groupId   String?
  posts     Post[]
  Group     Group?   @relation(fields: [groupId], references: [id])
}

model Course {
  id          String   @id @default(uuid())
  name        String
  thumbnail   String
  published   Boolean  @default(false)
  privacy     String
  description String
  createdAt   DateTime @default(now())
  groupId     String?
  Group       Group?   @relation(fields: [groupId], references: [id])
  modules     Module[]
}

model Module {
  id        String    @id @default(uuid())
  courseId  String?
  title     String
  createdAt DateTime  @default(now())
  Course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section[]
}

model Section {
  id          String   @id @default(uuid())
  name        String   @default("New Section")
  icon        String   @default("doc")
  complete    Boolean  @default(false)
  createdAt   DateTime @default(now())
  moduleId    String?
  content     String?
  htmlContent String?
  JsonContent String?
  Module      Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Affiliate {
  id        String   @id @default(uuid())
  groupId   String?  @unique
  createdAt DateTime @default(now())
  Group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(uuid())
  message    String
  createdAt  DateTime @default(now())
  senderId   String?
  receiverId String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  classId   String?
  createdAt DateTime @default(now())
  role      String   @default("CLASS_ADMIN")
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model Student {
  id               String           @id @default(uuid())
  rollNo           String           @unique
  name             String
  password         String
  department       String?
  isFirstLogin     Boolean          @default(true)
  isAllowedInClass Boolean          @default(false)
  isAssignedWFH    Boolean          @default(false)
  wfhDeadline      DateTime?
  createdAt        DateTime         @default(now())
  classId          String?
  allowedClassDate String?
  avatar           String?          @db.LongText
  attendance       Attendance[]
  submissions      TaskSubmission[]
  attempts         ExamAttempt[]
  notes            Note[]
  messages         StudentMessage[]
  typingRuns       TypingGameRun[]
  resumeAnalyses   ResumeAnalysis[]
  class            Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model Class {
  id                 String              @id @default(uuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  students           Student[]
  admins             Admin[]
  noTaskDeclarations NoTaskDeclaration[]
  exams              Exam[]
  typingSessions     TypingGameSession[]
}

model Note {
  id        String   @id @default(uuid())
  studentId String
  content   String   @db.Text
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Attendance {
  id        String    @id @default(uuid())
  studentId String
  checkIn   DateTime
  checkOut  DateTime?
  date      String
  type      String    @default("CLASS")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
  @@index([studentId, date])
}

model Task {
  id          String           @id @default(uuid())
  title       String
  description String           @db.Text
  createdAt   DateTime         @default(now())
  submissions TaskSubmission[]
}

model TaskSubmission {
  id          String   @id @default(uuid())
  taskId      String
  studentId   String
  content     String   @db.Text
  submittedAt DateTime @default(now())
  status      String   @default("PENDING")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([studentId])
}

model Exam {
  id               String         @id @default(uuid())
  title            String
  duration         Int
  createdAt        DateTime       @default(now())
  examCode         String?
  type             String         @default("MCQ")
  classId          String?
  isActive         Boolean        @default(true)
  isAnswerRevealed Boolean        @default(false)
  class            Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  questions        ExamQuestion[]
  attempts         ExamAttempt[]

  @@index([classId])
}

model ExamQuestion {
  id            String  @id @default(uuid())
  examId        String
  questionText  String  @db.Text
  optionA       String? @db.Text
  optionB       String? @db.Text
  optionC       String? @db.Text
  optionD       String? @db.Text
  correctAnswer String?
  constraints   String? @db.Text
  inputFormat   String? @db.Text
  outputFormat  String? @db.Text
  sampleInput   String? @db.Text
  sampleOutput  String? @db.Text
  testCases     String? @db.Text
  title         String?
  exam          Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id                String    @id @default(uuid())
  examId            String
  studentId         String
  score             Int
  answers           String    @db.Text
  warnings          Int       @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  codingSubmissions String?   @db.Text
  exam              Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
}

model NoTaskDeclaration {
  id        String   @id @default(uuid())
  date      String
  classId   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([date, classId])
}

model StudentMessage {
  id        String   @id @default(uuid())
  message   String   @db.Text
  createdAt DateTime @default(now())
  studentId String?
  adminName String?
  isAdmin   Boolean  @default(false)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model TypingGameSession {
  id        String          @id @default(uuid())
  isActive  Boolean         @default(false)
  passage   String          @db.Text
  createdAt DateTime        @default(now())
  timeLimit Int             @default(60)
  classId   String?
  password  String?
  runs      TypingGameRun[]
  class     Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model TypingGameRun {
  id                 String            @id @default(uuid())
  sessionId          String
  studentId          String
  wpm                Float             @default(0)
  accuracy           Float             @default(0)
  progressPercentage Float             @default(0)
  isCompleted        Boolean           @default(false)
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  session            TypingGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([studentId])
}

model CourseMaterial {
  id          String               @id @default(uuid())
  title       String
  description String?              @db.Text
  fileUrl     String?
  fileName    String?
  isLocked    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  pages       CourseMaterialPage[]
}

model CourseMaterialPage {
  id               String         @id @default(uuid())
  pageNumber       Int
  title            String?
  content          String?        @db.Text
  imageUrl         String?
  isLocked         Boolean        @default(false)
  courseMaterialId String
  courseMaterial   CourseMaterial @relation(fields: [courseMaterialId], references: [id], onDelete: Cascade)

  @@index([courseMaterialId])
}

model ResumeAnalysis {
  id             String   @id @default(uuid())
  studentId      String
  jobTitle       String?
  companyName    String?
  jobDescription String   @db.Text
  resumeText     String   @db.Text
  matchScore     Int
  summary        String   @db.Text
  matchingSkills String   @db.Text
  missingSkills  String   @db.Text
  improvements   String   @db.Text
  interviewPrep  String   @db.Text
  createdAt      DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum GROUP_PRIVACY {
  PUBLIC
  PRIVATE
}
