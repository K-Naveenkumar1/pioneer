generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String  @id @default(uuid())
  firstname String
  lastname  String
  clerkId   String  @unique
  image     String?
  stripeId  String

  group      Group[]
  membership Members[]
  posts      Post[]
  likes      Like[]
  comments   Comment[]
  message    Message[]
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  price     Int?
  active    Boolean  @default(false)
  Group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
}

model Group {
  id              String         @id @default(uuid())
  name            String         @unique
  category        String
  thumbnail       String?
  description     String?
  gallery         String?
  JsonDescription String?
  htmlDescription String?
  icon            String?
  member          Members[]
  channel         Channel[]
  privacy         GROUP_PRIVACY  @default(PRIVATE)
  active          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  courses         Course[]
  affiliate       Affiliate?
  domain          String?
  subscription    Subscription[]
}

model Members {
  id        String   @id @default(uuid())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  Group     Group?   @relation(fields: [groupId], references: [id])
  groupId   String?
  createdAt DateTime @default(now())

  @@index([userId, groupId])
}

model Post {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  title       String?
  JsonContent String?
  htmlContent String?
  content     String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  likes       Like[]
  comments    Comment[]
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Comment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  content   String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  replied   Boolean?  @default(false)
  reply     Comment[] @relation(name: "CommentToComment")
  Comment   Comment?  @relation(name: "CommentToComment", fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commentId String?
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  icon      String
  posts     Post[]
  createdAt DateTime @default(now())
  Group     Group?   @relation(fields: [groupId], references: [id])
  groupId   String?
}

model Course {
  id          String   @id @default(uuid())
  name        String
  thumbnail   String
  published   Boolean  @default(false)
  privacy     String
  description String
  createdAt   DateTime @default(now())
  Group       Group?   @relation(fields: [groupId], references: [id])
  groupId     String?
  modules     Module[]
}

model Module {
  id        String    @id @default(uuid())
  Course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String?
  title     String
  section   Section[]
  createdAt DateTime  @default(now())
}

model Section {
  id          String   @id @default(uuid())
  name        String   @default("New Section")
  icon        String   @default("doc")
  complete    Boolean  @default(false)
  createdAt   DateTime @default(now())
  Module      Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId    String?
  content     String?
  htmlContent String?
  JsonContent String?
}

model Affiliate {
  id        String   @id @default(uuid())
  Group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?  @unique
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  message    String
  createdAt  DateTime @default(now())
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String?
  receiverId String?
}

enum GROUP_PRIVACY {
  PUBLIC
  PRIVATE
}

// ==========================================
// NEW MODELS FOR STUDENT EXAM & PRACTICE PLATFORM
// ==========================================

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String // hashed password
}

model Student {
  id           String           @id @default(uuid())
  rollNo       String           @unique
  name         String
  password     String // hashed password
  department   String?
  isFirstLogin Boolean          @default(true)
  isAllowedInClass Boolean      @default(false)
  isAssignedWFH    Boolean      @default(false)
  wfhDeadline      DateTime?
  createdAt    DateTime         @default(now())
  attendance   Attendance[]
  submissions  TaskSubmission[]
  attempts     ExamAttempt[]
  notes        Note[]
  messages     StudentMessage[]
  classId      String?
  class        Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model Class {
  id                 String    @id @default(uuid())
  name               String    @unique
  students           Student[]
  noTaskDeclarations NoTaskDeclaration[]
  createdAt          DateTime  @default(now())
}

model Note {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  date      String   // yyyy-mm-dd format
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
}

model Attendance {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkIn   DateTime
  checkOut  DateTime?
  date      String    // yyyy-mm-dd format
  type      String    @default("CLASS") // CLASS or WFH
}

model Task {
  id          String           @id @default(uuid())
  title       String
  description String           @db.Text
  createdAt   DateTime         @default(now())
  submissions TaskSubmission[]
}

model TaskSubmission {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  submittedAt DateTime @default(now())
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
}

model Exam {
  id        String         @id @default(uuid())
  title     String
  duration  Int            // in minutes
  createdAt DateTime       @default(now())
  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id            String @id @default(uuid())
  examId        String
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String @db.Text
  optionA       String @db.Text
  optionB       String @db.Text
  optionC       String @db.Text
  optionD       String @db.Text
  correctAnswer String // A, B, C, or D
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  answers     String    @db.Text // JSON string of selected answers
  warnings    Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model NoTaskDeclaration {
  id        String   @id @default(uuid())
  date      String   // yyyy-mm-dd
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([date, classId])
}

model StudentMessage {
  id        String   @id @default(uuid())
  message   String   @db.Text
  createdAt DateTime @default(now())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

